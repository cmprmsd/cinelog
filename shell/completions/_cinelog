;;
(archive-legacy)
_arguments "${_arguments_options[@]}" : \
'--to=[Directory for the copies (\`<DIR>/<path below the logs directory>.zst\`); not inside the logs directory]:DIR:_files' \
'--dry-run[List what would be archived without writing anything]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(import)
_arguments "${_arguments_options[@]}" : \
'--report[Per-file banners, log lines, aligned commands and mean confidence]' \
'--json[]' \
'-h[Print help]' \
'--help[Print help]' \
