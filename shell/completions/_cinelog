#compdef cinelog

autoload -U is-at-least

_cinelog() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_cinelog_commands" \
"*::: :->cinelog" \
&& ret=0
    case $state in
    (cinelog)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:cinelog-command-$line[1]:"
        case $line[1] in
            (rec)
_arguments "${_arguments_options[@]}" : \
'(--protocol)--check[Print the start decision (\`start <scope> <reason>\`, \`recorded <uuid>\`, \`skip <reason>\`) and exit]' \
'--protocol[Print the supported marker protocol version and exit]' \
'-h[Print help]' \
'--help[Print help]' \
'*::command -- Shell and its arguments (after `--`):_default' \
&& ret=0
;;
(link)
_arguments "${_arguments_options[@]}" : \
'--json[Print JSON (\`{"uuid","cast","url","state"}\`) instead of text]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(pause)
_arguments "${_arguments_options[@]}" : \
'--reason=[Free-text reason stored in the pause marker]:REASON:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(resume)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
'--json[]' \
'(--json)--skew[Only the local version-skew checks\: print one line per warning and always exit 0 (the plugin'\''s MOTD line)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(install)
_arguments "${_arguments_options[@]}" : \
'--module=[With --team\: the cinelog module checkout to install the plugin from (default\: the one the running binary lives in)]:DIR:_files' \
'--binary=[With --team\: the binary to install (default\: the module'\''s bin/cinelog, else the running binary if it is part of the module)]:PATH:_files' \
'--prefix=[Write every system path below this directory instead of \`/\` (tests)]:DIR:_files' \
'--team[System-wide TEAM install (root)\: binary, root-owned plugin copy, dirs]' \
'--system-zshrc[With --team\: add the guarded block to the system zshrc]' \
'--upgrade[With --team\: replace an existing team binary after verifying its checksum]' \
'--allow-unverified[With --team\: install a binary that \`shell/checksums/\` does not list (local builds)]' \
'(--team --uninstall)--refresh[Refresh the ~/.local/bin symlink and restart this user'\''s running server (unit or detached)]' \
'--uninstall[Remove units, symlinks and the system zshrc block (casts are kept)]' \
'--no-migrate[Skip reading the old cinelog-settings.conf]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(serve)
_arguments "${_arguments_options[@]}" : \
'--scope=[Scope to serve; TEAM needs EUID 0 (default\: the scope of the current EUID)]:SCOPE:(personal team)' \
'--no-http[Indexer only\: no HTTPS listener]' \
'--ensure[Return at once if a server holds serve.lock; otherwise start one (systemd user unit if installed, else a detached process) and return]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(search)
_arguments "${_arguments_options[@]}" : \
'--user=[]:USER:_default' \
'--host=[]:HOST:_default' \
'--since=[Not before\: a date/time (\`2026-11-01\`, \`2026-11-01T14\:00\`) or an age (\`2d\`, \`3h\`)]:WHEN:_default' \
'--until=[Not after\: same forms as --since]:WHEN:_default' \
'--exit=[Exit status\: a number, \`ok\` or \`fail\`]:STATUS:_default' \
'--cwd=[Commands run in this directory or below it (\`.\` is the current one)]:DIR:_default' \
'--pane=[tmux pane id (e.g. \`%3\`)]:PANE:_default' \
'*--tag=[Only commands and output an annotation with this tag is attached to; repeat or separate with commas\: one annotation must carry all of them]:TAG:_default' \
'--limit=[Maximum number of results]:LIMIT:_default' \
'(--out)-a[Also search command output]' \
'(--out)--all[Also search command output]' \
'--out[Search command output only]' \
'-s[Case-sensitive match (default\: Unicode case-insensitive)]' \
'--case-sensitive[Case-sensitive match (default\: Unicode case-insensitive)]' \
'--json[Print JSON lines instead of running fzf]' \
'(--json)--print[Print the plain list instead of running fzf]' \
'--team[Search the team server'\''s history over HTTPS with your team token (\`token team-login\`)]' \
'-h[Print help]' \
'--help[Print help]' \
'*::term -- Search term (words are joined with single spaces); empty lists the newest commands:_default' \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
'--max-bytes=[Maximum output bytes to print]:BYTES:_default' \
'--json[]' \
'--team[Look the entry up on the team server (\`cinelog token team-login\`); the preview of \`search --team\`]' \
'-h[Print help]' \
'--help[Print help]' \
':id -- `<uuid>`, `<uuid>\:<seq>` or `<uuid>@<t>` (the hidden first field of `search`):_default' \
&& ret=0
;;
(forget)
_arguments "${_arguments_options[@]}" : \
'--from=[With a session id\: forget only output from this cast offset (seconds)]:SECS:_default' \
'--to=[With a session id\: forget only output up to this cast offset (seconds)]:SECS:_default' \
'-h[Print help]' \
'--help[Print help]' \
':id -- `<uuid>` (whole session) or `<uuid>\:<seq>` (one command):_default' \
&& ret=0
;;
(index)
_arguments "${_arguments_options[@]}" : \
'--once[Index new and changed casts once (only while no writer holds the lock)]' \
'--rebuild[Drop index.db and rebuild it from the casts (meta.db is kept)]' \
