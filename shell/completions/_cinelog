(( $+functions[_cinelog_commands] )) ||
_cinelog_commands() {
    local commands; commands=(
'rec:Record a shell in a new PTY (normally exec'\''d by the zsh plugin)' \
'link:Print the session id, cast path and web URL of the current recording' \
'pause:Pause recording of the current session (leaves a visible pause marker)' \
'resume:Resume a paused or degraded recording' \
'doctor:Diagnose the installation and the current shell' \
'install:Install or refresh cinelog for this user, or system-wide with --team' \
'serve:Index this scope'\''s casts and serve the web UI (HTTPS); one instance per scope' \
'search:Search commands, and with -a their output; interactive with fzf' \
'show:Print a command (or session) with its output; the fzf preview of \`search\`' \
'forget:Remove a command, time range or session from the index (casts are never rewritten)' \
'index:Index the casts once, or rebuild the index from the casts' \
'status:Indexer lag, backlog, legacy import progress and server state' \
'compress:Compress finished casts older than \`retention.compress_after_days\` (never legacy casts)' \
'archive-legacy:Write zstd copies of the legacy casts to another directory (the originals stay as they are)' \
'import:Legacy import report (aggregate numbers only)' \
'meta:Export or import meta.db (annotations, tags, forget list, settings)' \
'token:Manage web login tokens (TEAM\: one named token per member)' \
'tls:Show or regenerate the web server'\''s TLS certificate' \
'completions:Print a shell completion script' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'cinelog commands' commands "$@"
}
